source "https://rubygems.org"

ruby "3.2.2"

# Web framework - intentionally older to show upgrades
# (Rails 7.0 still has plenty of room to upgrade to latest versions)
gem "rails", "7.0.0"

# Authentication
gem "devise", "4.9.0"

# Authorization
gem "pundit", "2.3.0"

# Environment variables
gem "dotenv", "2.8.0"

# Testing
group :development, :test do
  gem "rspec-rails", "6.0.0"
  gem "rspec", "3.12.0"
end

group :development do
  gem "pry"
end

